# ===========================================
# Propnica Local Development Environment
# ===========================================
# Copy this file to .env.local for local development
# Run: cp .env.local.example .env.local

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Local Database (Docker)
# ===========================================
# Start with: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/propnica

# ===========================================
# Development Auth Bypass
# ===========================================
# Set to "true" to bypass Supabase auth and use a mock dev user
# This eliminates the need for Supabase in local development
DEV_AUTH_BYPASS=true
DEV_USER_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
DEV_USER_EMAIL=dev@propnica.local

# ===========================================
# Supabase Auth (Optional for local dev)
# ===========================================
# Only needed if DEV_AUTH_BYPASS=false
# You can use your Supabase cloud project for auth while
# connecting to a local database
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Map & Geocoding Configuration
# ===========================================
# Mapbox is used for map rendering
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Google Maps API key for geocoding (more accurate than Mapbox)
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===========================================
# AI Configuration
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# Stripe (Test Mode - Optional)
# ===========================================
# STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
# STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ===========================================
# Feature Flags
# ===========================================
ENABLE_GOOGLE_AUTH=false
ENABLE_RENDER_QUEUE=false
ENABLE_EMAIL_NOTIFICATIONS=false
