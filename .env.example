# ===========================================
# Propnica Environment Configuration
# ===========================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Remotion Lambda Configuration
REMOTION_AWS_REGION=eu-west-1
REMOTION_AWS_ACCESS_KEY_ID=your-aws-access-key
REMOTION_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-propnica
REMOTION_S3_BUCKET=propnica-renders
REMOTION_SERVE_URL=your-remotion-serve-url

# AWS S3 Configuration
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_RENDERS_BUCKET=propnica-renders
S3_ASSETS_BUCKET=propnica-assets
S3_THUMBNAILS_BUCKET=propnica-thumbnails

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@propnica.com

# Rate Limiting
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100
RATE_LIMIT_RENDER=10
RATE_LIMIT_UPLOAD=20

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_BUSINESS=price_business_id

# AI Configuration (for AI Project Generator)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Feature Flags
ENABLE_GOOGLE_AUTH=true
ENABLE_RENDER_QUEUE=true
ENABLE_EMAIL_NOTIFICATIONS=true
