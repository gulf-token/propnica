# ===========================================
# Propnica Environment Configuration
# ===========================================
# For AWS deployment, most values are populated from SSM Parameter Store
# For local development, copy .env.local.example to .env.local

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://propnica.app

# ===========================================
# Database (AWS RDS PostgreSQL)
# ===========================================
# Retrieved from SSM: /propnica/{environment}/database/url
DATABASE_URL=postgresql://user:password@host:5432/propnica?sslmode=require

# ===========================================
# Authentication
# ===========================================
# Option 1: Supabase Auth (cloud)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Option 2: Development bypass (for local dev)
# DEV_AUTH_BYPASS=true
# DEV_USER_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
# DEV_USER_EMAIL=dev@propnica.local

# ===========================================
# Mapbox Configuration
# ===========================================
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# ===========================================
# AWS Configuration
# ===========================================
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 Buckets
S3_RENDERS_BUCKET=propnica-renders-production
S3_ASSETS_BUCKET=propnica-assets-production
S3_THUMBNAILS_BUCKET=propnica-thumbnails-production

# ===========================================
# Remotion Lambda Configuration
# ===========================================
REMOTION_AWS_REGION=eu-central-1
REMOTION_AWS_ACCESS_KEY_ID=your-aws-access-key
REMOTION_AWS_SECRET_ACCESS_KEY=your-aws-secret-key
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-production
REMOTION_S3_BUCKET=propnica-renders-production
REMOTION_SERVE_URL=https://remotion-serve-url

# ===========================================
# Stripe Configuration
# ===========================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_BUSINESS=price_business_id

# ===========================================
# AI Configuration
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# Email Configuration (optional)
# ===========================================
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-user
SMTP_PASS=your-ses-smtp-password
EMAIL_FROM=noreply@propnica.app

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=100
RATE_LIMIT_RENDER=10
RATE_LIMIT_UPLOAD=20

# ===========================================
# Feature Flags
# ===========================================
ENABLE_GOOGLE_AUTH=true
ENABLE_RENDER_QUEUE=true
ENABLE_EMAIL_NOTIFICATIONS=true
