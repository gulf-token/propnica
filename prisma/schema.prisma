// PropertyClips Database Schema
// Using Prisma with Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================
// User Profile (extends Supabase Auth users)
// ===========================================
model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(100)
  company     String?  @db.VarChar(200)
  avatarUrl   String?  @map("avatar_url") @db.Text
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  projects  Project[]
  renders   Render[]
  templates Template[]

  @@map("user_profiles")
}

// ===========================================
// Project
// ===========================================
model Project {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(200)
  description  String?   @db.Text
  config       Json      @default("{}")
  thumbnailUrl String?   @map("thumbnail_url") @db.Text
  duration     Int       @default(30)
  isTemplate   Boolean   @default(false) @map("is_template")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user    UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  renders Render[]

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
  @@index([isTemplate])
  @@map("projects")
}

// ===========================================
// Render Job
// ===========================================
model Render {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  status       RenderStatus @default(QUEUED)
  resolution   Resolution   @default(HD_1080P)
  progress     Int          @default(0)
  outputUrl    String?      @map("output_url") @db.Text
  fileSize     Int?         @map("file_size")
  errorMessage String?      @map("error_message") @db.Text
  renderId     String?      @map("render_id") @db.VarChar(100)
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("renders")
}

// ===========================================
// Template
// ===========================================
model Template {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.Text
  config      Json     @default("{}")
  thumbnailUrl String? @map("thumbnail_url") @db.Text
  category    String?  @db.VarChar(50)
  isPublic    Boolean  @default(false) @map("is_public")
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@index([category])
  @@map("templates")
}

// ===========================================
// Enums
// ===========================================
enum RenderStatus {
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum Resolution {
  HD_720P
  HD_1080P
  UHD_4K
}
